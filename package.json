{
  "name": "@vitemcp/server",
  "version": "1.0.0",
  "main": "dist/ViteMCP.js",
  "scripts": {
    "build": "tsup",
    "lint": "prettier --check . && eslint . && tsc --noEmit && jsr publish --dry-run",
    "test": "vitest run",
    "format": "prettier --write . && eslint --fix .",
    "test:coverage": "vitest run --coverage"
  },
  "bin": {
    "vitemcp": "dist/bin/vitemcp.js"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "llm",
    "ai",
    "server",
    "typescript"
  ],
  "type": "module",
  "author": "Frank Fiegel <frank@glama.ai>",
  "license": "MIT",
  "description": "A TypeScript framework for building stateless MCP servers — deploy to serverless and edge.",
  "module": "dist/ViteMCP.js",
  "types": "dist/ViteMCP.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/ViteMCP.d.ts",
        "default": "./dist/ViteMCP.js"
      },
      "require": {
        "types": "./dist/ViteMCP.d.cts",
        "default": "./dist/ViteMCP.cjs"
      }
    },
    "./auth": {
      "import": {
        "types": "./dist/auth/index.d.ts",
        "default": "./dist/auth/index.js"
      },
      "require": {
        "types": "./dist/auth/index.d.cts",
        "default": "./dist/auth/index.cjs"
      }
    },
    "./edge": {
      "import": {
        "types": "./dist/edge/index.d.ts",
        "default": "./dist/edge/index.js"
      },
      "require": {
        "types": "./dist/edge/index.d.cts",
        "default": "./dist/edge/index.cjs"
      }
    }
  },
  "dependencies": {
    "@modelcontextprotocol/core": "^2.0.0",
    "@modelcontextprotocol/node": "^2.0.0",
    "@modelcontextprotocol/server": "^2.0.0",
    "@standard-schema/spec": "^1.0.0",
    "execa": "^9.6.1",
    "file-type": "^21.1.1",
    "fuse.js": "^7.1.0",
    "hono": "^4.11.5",
    "strict-event-emitter-types": "^2.0.0",
    "undici": "^7.16.0",
    "uri-templates": "^0.2.0",
    "xsschema": "^0.4.3",
    "yargs": "^18.0.0",
    "zod": "^4.4.3",
    "zod-to-json-schema": "^3.25.0"
  },
  "peerDependencies": {
    "ajv": "^8.0.0",
    "ajv-formats": "^3.0.0",
    "jose": "^5.0.0 || ^6.0.0"
  },
  "peerDependenciesMeta": {
    "ajv": {
      "optional": true
    },
    "ajv-formats": {
      "optional": true
    },
    "jose": {
      "optional": true
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vitemcp/server.git"
  },
  "homepage": "https://github.com/vitemcp/server",
  "publishConfig": {
    "access": "public"
  },
  "release": {
    "branches": [
      "main"
    ],
    "plugins": [
      "@semantic-release/commit-analyzer",
      "@semantic-release/release-notes-generator",
      "@semantic-release/npm",
      "@semantic-release/github",
      "@sebbo2002/semantic-release-jsr"
    ]
  },
  "files": [
    "dist"
  ],
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@modelcontextprotocol/client": "^2.0.0",
    "@modelcontextprotocol/inspector": "^0.16.8",
    "@sebbo2002/semantic-release-jsr": "^3.1.0",
    "@tsconfig/node24": "^24.0.3",
    "@types/node": "^24.10.1",
    "@types/uri-templates": "^0.1.34",
    "@types/yargs": "^17.0.35",
    "@valibot/to-json-schema": "^1.4.0",
    "@vitest/coverage-v8": "^4.0.15",
    "@wong2/mcp-cli": "^1.13.0",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "arktype": "^2.1.28",
    "eslint": "^9.39.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-perfectionist": "^4.15.1",
    "eslint-plugin-prettier": "^5.5.4",
    "eventsource-client": "^1.2.0",
    "get-port-please": "^3.2.0",
    "jiti": "^2.6.1",
    "jsr": "^0.13.5",
    "prettier": "^3.7.4",
    "semantic-release": "^25.0.2",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.48.1",
    "valibot": "^1.2.0",
    "vitest": "^4.0.15"
  },
  "tsup": {
    "entry": [
      "src/ViteMCP.ts",
      "src/bin/vitemcp.ts",
      "src/auth/index.ts",
      "src/edge/index.ts"
    ],
    "format": [
      "esm",
      "cjs"
    ],
    "dts": true,
    "splitting": true,
    "sourcemap": true,
    "clean": true
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@10.19.0",
  "bugs": {
    "url": "https://github.com/vitemcp/server/issues"
  }
}
